# Load commonly used libraries
library(tidyverse)   # Collection of packages for data manipulation & visualization
library(dplyr)       # For data wrangling (filter, select, mutate, summarize, etc.)
library(ggplot2)     # For plotting and visualization
library(readr)       # For reading CSV or text files
library(tidyr)       # For reshaping data
View(data)
ggplot2(data, aes(y = mpg, x = wt)) +
geom_point(size =3, fill_color = "Blue") +
ggtitle('scatterplot of mpg (miles per gallon) vs. wt (weight in 1000 lbs)')
ggplot2(data = data, aes(y = mpg, x = wt)) +
geom_point(size =3, fill_color = "Blue") +
ggtitle('scatterplot of mpg (miles per gallon) vs. wt (weight in 1000 lbs)')
data("mtcars")      # load it (optional; mtcars is usually preloaded)
df <- mtcars      # copy to your own object
head(data, 5)
str(data)
ggplot2(data = df, aes(x = wt, y = mpg)) +
geom_point(size = 3, color = "blue") +
labs(
title = "Scatterplot of MPG vs. Weight",
x = "Weight (1000 lbs)",
y = "Miles per Gallon"
) +
theme_minimal()
ggplot(data = df, aes(x = wt, y = mpg)) +
geom_point(size = 3, color = "blue") +
labs(
title = "Scatterplot of MPG vs. Weight",
x = "Weight (1000 lbs)",
y = "Miles per Gallon"
) +
theme_minimal()
cor(df$mpg, df$wt)
